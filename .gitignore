# bags & data never go in git
*.bag
*.db3
*.mcap
*.pcap
*.pcd
*.ply
mapping_bags/
# builds — every PlatformIO project, not one by name. The battery_monitor
# project got 644 object files (66 MB) into git because this was a literal
# path instead of a glob.
.pio/
__pycache__/
*.pyc
# credentials -- this repo is PUBLIC. Only the .example template is tracked.
incors.conf
**/incors.conf
*.secret
