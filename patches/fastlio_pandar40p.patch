         }
         else
         {
-            sub_pcl_pc_ = this->create_subscription<sensor_msgs::msg::PointCloud2>(lid_topic, rclcpp::SensorDataQoS(), standard_pcl_cbk);
+            // SensorDataQoS() is BEST_EFFORT depth 5. Measured 2026-08-01 on
+            // run_20260801_014240: a RELIABLE depth-200 subscriber receives
+            // 677 of 678 frames while a BEST_EFFORT depth-5 one receives 45,
+            // and the mapper itself processed 115. The loss was never compute
+            // (~5 ms/frame against a 100 ms budget) or disk (the bag records
+            // 100% of frames) -- it was this line silently dropping ~2/3 of
+            // the cloud. Playback offers RELIABLE (metadata.yaml reliability:
+            // 1), so this is QoS-compatible.
+            rclcpp::QoS pc_qos(rclcpp::KeepLast(100));
+            pc_qos.reliable();
+            sub_pcl_pc_ = this->create_subscription<sensor_msgs::msg::PointCloud2>(lid_topic, pc_qos, standard_pcl_cbk);
         }
         sub_imu_ = this->create_subscription<sensor_msgs::msg::Imu>(imu_topic, 10, imu_cbk);
         pubLaserCloudFull_ = this->create_publisher<sensor_msgs::msg::PointCloud2>("/cloud_registered", 20);
diff --git a/src/preprocess.cpp b/src/preprocess.cpp
index 9015782..629b8f0 100644
--- a/src/preprocess.cpp
+++ b/src/preprocess.cpp
@@ -304,6 +304,16 @@ void Preprocess::velodyne_handler(const sensor_msgs::msg::PointCloud2::UniquePtr
   int plsize = pl_orig.points.size();
   if (plsize == 0)
     return;
+  /*** Hesai driver emits ABSOLUTE epoch seconds per point; FAST-LIO expects
+       offsets from scan start. Normalize in place. No-op if already relative. ***/
+  if (pl_orig.points[0].time > 1e8)
+  {
+    const double ts_base = pl_orig.points[0].time;
+    for (int i = 0; i < plsize; i++)
+    {
+      pl_orig.points[i].time -= ts_base;
+    }
+  }
   pl_surf.reserve(plsize);
 
   /*** These variables only works when no point timestamps given ***/
